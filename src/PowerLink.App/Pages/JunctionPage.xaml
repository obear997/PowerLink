<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="PageRoot"
    x:Class="PowerLink.App.Pages.JunctionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PowerLink.App.ViewModels"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="目录联接" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.7"
                   Text="创建目录联接 —— 一个让某个文件夹出现在另一个路径下的指针。同一卷或跨本地卷均可。无需管理员或开发者模式。删除联接永远不会影响目标的内容。"/>

        <InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="什么是目录联接？"
                 Message="一个目录指针 —— 联接文件夹出现在自己的路径下，但内容来自目标。目标必须是本地文件夹（不支持 UNC）。创建或删除都不需要管理员。删除联接只会移除指针，绝不会删除目标内容。"/>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Header="目标文件夹（联接指向的位置）"
                     Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay}"
                     PlaceholderText="C:\path\to\real\folder"/>
            <Button Grid.Column="1" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.PickTargetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Folder"/>
                    <TextBlock Text="浏览"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Header="父文件夹（联接创建的位置）"
                     Text="{x:Bind ViewModel.ParentPath, Mode=TwoWay}"
                     PlaceholderText="C:\path\where\junction\appears"/>
            <Button Grid.Column="1" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.PickParentCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Folder"/>
                    <TextBlock Text="浏览"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBox Grid.Row="5"
                 Header="联接名称（默认由目标推导 —— 如需不同名称可修改）"
                 Text="{x:Bind ViewModel.LinkName, Mode=TwoWay}"
                 PlaceholderText="my-junction"/>

        <CheckBox Grid.Row="6"
                  Content="允许目标不存在（创建悬空联接）"
                  IsChecked="{x:Bind ViewModel.AllowMissingTarget, Mode=TwoWay}"
                  ToolTipService.ToolTip="默认要求目标文件夹已存在。勾选后可以创建目标尚不存在的联接。"/>

        <StackPanel Grid.Row="7" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.CreateCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Link"/>
                        <TextBlock Text="创建联接"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ResetCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Clear"/>
                        <TextBlock Text="重置"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="13"/>
        </StackPanel>
    </Grid>
</Page>
